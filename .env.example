# Finova environment template. Copy to .env; all credentials below are intentionally blank.

# REQUIRED FOR LOCAL DEMO (mock mode; no accounts, database, or API keys needed)
DATA_SOURCE=mock
DATA_BACKEND=mock
MODEL_PROVIDER=mock
ENABLE_DEMO_ROUTES=false
QUIKIT_AUTH_ENABLED=false
BUSINESS_STATE=Madhya Pradesh
LOG_LEVEL=info
FINOVA_AI_RATE_LIMIT_MAX=8
FINOVA_AI_RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_FINOVA_AI_RATE_LIMIT_MAX=8
NEXT_PUBLIC_FINOVA_AI_RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_FINOVA_PREMIUM=false
FINOVA_PREMIUM=false
NEXT_PUBLIC_SUPPORT_EMAIL=support@finova.example

# OPTIONAL (local integrations; leave unset for a standalone demo)
# Database is required only with DATA_SOURCE=prisma.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Shared cache/rate limiting for multi-instance deployments.
REDIS_URL=
REDIS_TOKEN=
# Optional alert digest and receipt ingestion secrets.
INTERNAL_SECRET=
FINOVA_RECEIPT_INGEST_SECRET=
# Optional legacy Gemini assistant/search configuration; keys are rotated sequentially.
GEMINI_ENABLED=false
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000
NL_SEARCH_LLM=false
NL_SEARCH_LLM_PROVIDER=
NL_SEARCH_LLM_API_KEY=
NL_SEARCH_LLM_TIMEOUT_MS=2500
# Optional local Ollama provider (install and start Ollama separately).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Model and data backend settings (mock needs no additional variables).
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
MODEL_TIMEOUT_MS=15000
# Supabase is not currently implemented; selection safely falls back to mock.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional support for client-side feature flags.
NEXTAUTH_URL=http://localhost:3011
APP_URL=http://localhost:3011
# Public login redirect link (never place a credential here).
NEXT_PUBLIC_AUTH_URL=

# PRODUCTION-ONLY (set in the hosting environment, never commit credentials)
# Set a strong random secret when real authentication is configured.
NEXTAUTH_SECRET=
# Authentication adapter is dormant unless explicitly enabled. Supply the private service URL only
# in production secret management; demo identity continues when disabled in mock mode.
AUTH_SERVICE_URL=
